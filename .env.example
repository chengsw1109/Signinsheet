# 複製此檔為 .env 並填入實際值，系統啟動時會自動讀取
# （.env 已被 git 忽略，金鑰不會被上傳）

# 管理員密碼（正式使用務必更換）
ADMIN_PASSWORD=admin123

# ---- LINE 通知（到 https://developers.line.biz/console/ 建立 Messaging API channel 取得）----
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
# 接收每日統計／每月報表的管理員 LINE User ID（對官方帳號傳「id」可查），逗號分隔
LINE_ADMIN_IDS=

# ---- ngrok 固定網域（使用 start-all.bat 一鍵啟動時會自動帶入）----
# NGROK_DOMAIN=您的網域.ngrok-free.app

# ---- 對外網址（LINE「預約」指令回覆的連結會用到，通常同 ngrok 網域）----
# PUBLIC_URL=https://您的網域.ngrok-free.app

# ---- 預約營業時間（可不改）----
# BOOK_OPEN=10:00
# BOOK_CLOSE=20:00
# BOOK_SLOT_MIN=30
# BOOK_WORKDAYS=1,2,3,4,5,6

# ---- Email 通知（選用；未設定時預約仍正常，只是不寄信）----
# 以 Gmail 為例：SMTP_HOST=smtp.gmail.com、SMTP_PORT=587、SMTP_USER 填 Gmail、
# SMTP_PASS 填「應用程式密碼」（非登入密碼，需於 Google 帳戶開啟兩步驟驗證後產生）
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=

# ---- Google 日曆（選用；未設定時預約仍正常，只是不寫入日曆）----
# 1. Google Cloud 建立服務帳戶並下載 JSON 金鑰
# 2. 把日曆共用給服務帳戶的 client_email（權限：變更活動）
# GOOGLE_SERVICE_ACCOUNT_JSON=./google-service-account.json
# GOOGLE_CALENDAR_ID=your-email@gmail.com

# ---- 出勤規則（可不改，使用預設值）----
# TZ_NAME=Asia/Taipei
# WORK_START=09:00
# LATE_GRACE_MIN=0
# LATE_REMIND_TIME=09:15
# CHECKOUT_REMIND_TIME=18:30
# DAILY_SUMMARY_TIME=19:00
# MONTHLY_REPORT_TIME=09:00
# WORKDAYS=1,2,3,4,5
# PORT=3000
